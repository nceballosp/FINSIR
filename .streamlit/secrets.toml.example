# Copia este archivo a .streamlit/secrets.toml (local) o pega su contenido en
# Streamlit Community Cloud → tu app → Settings → Secrets.
# Nunca subas el secrets.toml real: está en .gitignore.

# URL pública de la API en ECS. Cambia en cada redespliegue:
# obtén la actual con  .\dashboard\get_api_url.ps1
API_BASE_URL = "http://<IP-de-la-API>:8080"

# El mismo secreto que se configuró al desplegar la API (iac/api/deploy.ps1).
AUTH_DEV_SECRET = "<secreto-de-la-API>"
