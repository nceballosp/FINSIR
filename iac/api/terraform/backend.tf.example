# Store the Terraform state in S3 for team work.
# Rename this file to backend.tf and adjust the values.
# The bucket and DynamoDB table must exist before running terraform init.
terraform {
  backend "s3" {
    bucket         = "my-state-bucket"
    key            = "finsir-api/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "terraform-locks"
    encrypt        = true
  }
}
